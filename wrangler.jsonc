{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technical-blog",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "vars": {
    "PUBLIC_GA_MEASUREMENT_ID": "G-KVDZCN0M7L"
  }
}
